# ESP-IDF build output
/build/
sdkconfig
sdkconfig.old

# Host unit-test binaries (built by test/Makefile or gcc directly)
/test/run_*
/test/*.exe
/test/*.o

# Python caches
__pycache__/
*.pyc

# Editor / OS cruft
.vscode/
*.swp
.DS_Store

# NOTE: we intentionally DO track:
#   - assets/clips/*.pcm        (generated callout clips the firmware embeds)
#   - assets/original_audio/*   (source WAV masters, for re-conversion)
# so a fresh clone builds and the voice masters are preserved.
