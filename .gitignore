# ESP-IDF build output
/build/
sdkconfig
sdkconfig.old

# Host unit-test binaries (built by test/Makefile or gcc directly)
/test/run_*
/test/*.exe
/test/*.o

# Web emulator WASM build output (regenerated by emulator/build_wasm)
/emulator/dist/

# Web emulator standalone demo package (regenerated by emulator/package_demo.ps1)
/emulator/package/
/emulator/lidaragl-demo.zip

# Python caches
__pycache__/
*.pyc

# flash_esp32.bat's remembered default COM port (per-machine, not shared)
flash_esp32_default.txt

# Editor / OS cruft
.vscode/
.claude/
*.swp
.DS_Store

# NOTE: we intentionally DO track:
#   - assets/clips/*.pcm        (generated callout clips the firmware embeds)
#   - assets/original_audio/*   (source WAV masters, for re-conversion)
# so a fresh clone builds and the voice masters are preserved.
/SampleLibrary-master
diag.txt
vid_script.md
/ref
AUDIT_2026-07-25.md
