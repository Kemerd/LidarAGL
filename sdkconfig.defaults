# =============================================================================
#  LidarAGL — default sdkconfig
# -----------------------------------------------------------------------------
#  These defaults seed menuconfig. The builder may tweak in menuconfig, but the
#  radio-off and power-management settings below are load-bearing for the
#  design (no EMI into avionics; light-sleep in idle states) and should stay.
# =============================================================================

# ---- Target -----------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# ---- Custom partition table (dedicated NVS for the boot buffer) -------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Flash size (4 MB ESP32-S3 devkit) --------------------------------------
#  Pin the REAL chip geometry. Our partition table needs ~3.06 MB (the 3 MB
#  'factory' app at offset 0x10000), so the IDF default of 2 MB is too small and
#  the partition generator aborts with "does not fit in configured flash size".
#  4 MB holds the layout with ~960 KB to spare. This value feeds BOTH the
#  partition-table generator (--flash-size) and the flasher, so keep it matched
#  to the hardware; bump to 8MB/16MB here if a larger module is ever used.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ---- Radios OFF (spec §8) ---------------------------------------------------
#  Compiling the WiFi/BT stacks OUT (not merely "not started") removes their
#  code/RAM and guarantees zero draw and zero EMI radiated into the audio path
#  and the aircraft avionics bus. Note: the v5 WiFi Kconfig key is
#  CONFIG_ESP_WIFI_ENABLED (the old CONFIG_ESP32_WIFI_* family is gone).
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n
CONFIG_BLUEDROID_ENABLED=n
CONFIG_BT_BLE_ENABLED=n

# ---- Power management / light-sleep (spec §6.4) -----------------------------
#  esp_pm_configure() needs BOTH of these or it returns ESP_ERR_NOT_SUPPORTED.
#  The state machine drops the MCU into automatic light-sleep in GROUND/CRUISE,
#  where the tone is silent and the I2S channel is disabled.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
#  Dynamic-frequency-scaling floor; the audio task forces 240 MHz when active.
CONFIG_PM_DFS_INIT_AUTO=y

# ---- Logging over the native USB-Serial-JTAG (no UART0 pins consumed) -------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Main task / app behaviour ----------------------------------------------
#  app_main runs the one-shot boot sequence then spawns the real tasks, so it
#  can keep a modest stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---- Task watchdog ----------------------------------------------------------
#  The three flight-critical loops (sensor, logic, audio) subscribe themselves
#  to the TWDT and feed it each pass; see app_main.c. The IDF default only
#  watches the IDLE tasks, which cannot detect the failure that actually
#  matters here: all three loops block POLITELY (bounded queue waits, vTaskDelay,
#  100 ms I2S timeouts), so a task wedged inside a driver call leaves the idle
#  tasks running happily and nothing ever fires. The box just goes silent —
#  no reset, no chirp, no cue for the pilot to power-cycle.
#
#  PANIC=y is the point of the exercise: a reset RECOVERS. The boot path already
#  reconstructs an airborne state and seeds the ladder hot (see the airborne
#  seeding in app_main), so a watchdog reset in flight costs a few seconds of
#  audio and then resumes calling the approach. Staying wedged costs the whole
#  approach. Timeout is generous versus the slowest loop pass (GROUND polls at
#  750 ms, the stale-sample watchdog kicks at 2 s) so only a true hang trips it.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- Compiler ---------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
